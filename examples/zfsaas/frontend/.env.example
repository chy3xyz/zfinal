# App
SESSION_SECRET=dev-session-secret-change-me-please-32chars
PUBLIC_APP_URL=http://localhost:3000

# ZFinal backend (zfsaas). When set, prefer src/libs/zfinalClient.ts for auth/billing.
ZFINAL_API_URL=http://127.0.0.1:8080

# Database — local PGLite (npm run db-server) or Neon/Postgres
# Still used until all actions are migrated to ZFinal.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/saas

# Email (Resend). EMAIL_MOCK=true logs instead of sending (default in non-prod).
RESEND_API_KEY=
EMAIL_FROM=SaaS SolidJS <onboarding@resend.dev>
EMAIL_MOCK=true

# Stripe (frontend portal; webhook should target ZFinal :8080/api/billing/webhook when using BE)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ENTERPRISE=
